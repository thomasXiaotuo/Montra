# Copy this file to .env. Keep .env private. / 复制为 .env，不要分享真实密码。
# Existing container: leave SQL_PASSWORD empty to read its original SA password.
# Native/remote SQL Server or a non-sa account: set SQL_PASSWORD explicitly.
# New container: set a unique strong password (12+ chars, upper/lowercase, numbers, symbols).
# Single-quote passwords containing $ or #, for example SQL_PASSWORD='your-own-password'.
SQL_PASSWORD=
SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_USER=sa
SQL_DATABASE=jizhang
SQL_CONTAINER=sqlserver
# Windows/Linux default to native SQL Server (no Docker); macOS defaults to 1.
# 0 = never call Docker; 1 = allow starting an existing local container and reading its SA password.
# SQL_USE_DOCKER=0
# App port; all three launchers honor this value. / 三个平台的启动入口都读取此端口。
PORT=3210
# Optional: set 0 to skip opening a browser in the platform launcher.
# LEDGER_OPEN_BROWSER=0
